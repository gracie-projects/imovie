# Base URL of the API as seen by the browser.
# Leave unset in development: Vite proxies /api to the backend (see vite.config.js).
# In production set it to the deployed API, e.g. https://your-api.onrender.com/api,
# or keep "/api" and add a rewrite on your frontend host (see README "Deployment").
# VITE_API_URL=/api

# Where the Vite dev server forwards /api requests (development only).
# VITE_DEV_API_PROXY=http://localhost:5000
