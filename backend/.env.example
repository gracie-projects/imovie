# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/imovies
# MongoDB Atlas (example format – use your own cluster, user and password):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/imovies?retryWrites=true&w=majority

# ---- Authentication ----
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# ---- Frontend / cookies ----
# Browser origin(s) allowed to call the API (comma-separated).
CLIENT_URL=http://localhost:5173
# lax  = frontend and API on the same site (default; Vite proxy or a host rewrite)
# none = frontend and API on different sites (requires HTTPS in production)
COOKIE_SAMESITE=lax

# ---- Booking rules ----
SEAT_HOLD_MINUTES=8
MAX_SEATS_PER_BOOKING=10
CANCELLATION_CUTOFF_HOURS=2

# ---- Payments ----
# Only "demo" is implemented. No real money is charged in demo mode.
PAYMENT_PROVIDER=demo

# ---- First administrator (used only by `npm run create-admin`) ----
# Remove these values from the file after creating the account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
